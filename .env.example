# Global Development Pulse Environment Variables
# The platform relies on public World Bank Open Data APIs which do not require private API keys.

# Optional: Port configuration for local Next.js dev server
PORT=3000

# Optional: Deployment URL for absolute canonical URLs & Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://global-development-pulse.vercel.app

# Optional: Refresh interval threshold in hours (used by health check)
NEXT_PUBLIC_STALE_THRESHOLD_HOURS=24
